# ========================================
# Retail Video Analytics - Environment Variables
# ========================================

# === MinIO (S3-compatible Object Storage) ===
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_SERVER_URL=http://minio:9000

# === Iceberg REST Catalog ===
ICEBERG_CATALOG_URI=http://iceberg-rest:8181
ICEBERG_WAREHOUSE=s3a://warehouse

# === S3/MinIO Configuration for Iceberg FileIO ===
S3_ENDPOINT=http://minio:9000
S3_PATH_STYLE=true
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123

# === Grafana ===
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# === Airflow (Optional - not currently active) ===
AIRFLOW__CORE__FERNET_KEY=GENERATE_YOUR_OWN_FERNET_KEY_IF_USING_AIRFLOW
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow123
AIRFLOW_UID=1000
