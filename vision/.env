# ========================================
# Vision AI Module - Environment Variables Template
# ========================================
# Copy this file to .env in the vision/ directory
# cp vision/.env.example vision/.env

# === YOLO Model Configuration ===
# Model file must exist in vision/detect/models/
MODEL_NAME=yolo11l.pt

# === Video Input ===
# Path to video file (relative to vision/ directory) or camera device ID (0 for webcam)
VIDEO_PATH=video/0000000428600010000.mp4

# === Tracker Configuration ===
# Options: botsort, bytetrack, deepsort
TRACKER_TYPE=botsort

# === Detection Settings ===
# Classes to detect (COCO format): [0] = person only, [0,1,2] = multiple classes
CLASS_FILTER=[0]

# Confidence threshold (0.0 - 1.0)
CONF_THRES=0.25

# === Output Configuration ===
# Local JSONL output path (for debugging)
OUT_JSONL=../data/metadata/video.jsonl

# === Store/Camera Metadata ===
STORE_ID=store_01
CAMERA_ID=cam_01
STREAM_ID=stream_01

# === Pulsar Streaming Configuration ===
# Pulsar service URL (use localhost:6650 when running from host, pulsar-broker:6650 from Docker)
PULSAR_SERVICE_URL=pulsar://localhost:6650
PULSAR_TOPIC=persistent://retail/metadata/events

# === DeepSORT Advanced Tuning (for static cameras) ===
# Maximum number of frames to keep a track alive without detections
DS_MAX_AGE=120

# Minimum number of detections to confirm a track
DS_N_INIT=3

# Maximum IOU distance for matching detections to tracks
DS_MAX_IOU_DISTANCE=0.75

# Embedder model: torchreid, mobilenet, clip_RN50, clip_ViT-B/32
DEEPSORT_EMBEDDER=torchreid

# Use GPU for embedder (0=CPU, 1=GPU)
DEEPSORT_EMBEDDER_GPU=1

# Detection confidence threshold for DeepSORT
DS_DET_CONF=0.4

# Non-Maximum Suppression IOU threshold
DS_NMS_IOU=0.60

# Smoothing factor for track positions (0.0 - 1.0)
DS_SMOOTH_ALPHA=0.6

# Minimum IOU for smoothing
DS_SMOOTH_MIN_IOU=0.1
