# ========================================
# Retail Video Analytics - Environment Variables Template
# ========================================
# Copy this file to .env and fill in your actual values.

# === AWS S3 ===
S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
S3_PATH_STYLE=false
S3_REGION=ap-southeast-1
S3_BUCKET=s3-retail-video-analytics
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

# === Iceberg REST Catalog ===
ICEBERG_CATALOG_URI=http://iceberg-rest:8181
ICEBERG_WAREHOUSE=s3a://s3-retail-video-analytics/lakehouse
APP_TIME_ZONE=Asia/Ho_Chi_Minh
TRINO_TIME_ZONE=Asia/Ho_Chi_Minh
TRINO_QUERY_TIMEOUT_SEC=5
TRINO_QUERY_MAX_WAIT_SEC=20
FLINK_CHECKPOINTS_URI=s3a://s3-retail-video-analytics/flink/checkpoints
FLINK_SAVEPOINTS_URI=s3a://s3-retail-video-analytics/flink/savepoints

# === Postgres Databases ===
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=local
ICEBERG_DB_NAME=iceberg
ICEBERG_DB_USER=iceberg
ICEBERG_DB_PASSWORD=local

# === Pulsar Topics ===
PULSAR_DLQ_TOPIC=persistent://retail/metadata/dlq-events

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=16379
REDIS_PASSWORD=
REDIS_DB=0
