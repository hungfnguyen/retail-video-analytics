        {
            "id": 10,
            "type": "barchart",
            "title": "📊 Traffic by Hour (Today)",
            "description": "Hourly visitor distribution today",
            "datasource": {
                "type": "trino-datasource",
                "uid": "trino-lakehouse"
            },
            "gridPos": {
                "h": 8,
                "w": 24,
                "x": 0,
