{
    "uid": "rva_traffic_overview",
    "title": "RVA - Traffic Overview",
    "description": "Real-time and historical traffic analytics (Silver + Gold layer)",
    "editable": true,
    "schemaVersion": 38,
    "version": 1,
    "refresh": "5s",
    "timezone": "browser",
    "time": {
        "from": "now/d",
        "to": "now"
    },
    "templating": {
        "list": []
    },
    "panels": [
        {
            "id": 1,
            "type": "stat",
            "title": "👥 Total Visitors Today",
            "datasource": {
                "type": "trino-datasource",
                "uid": "trino-lakehouse"
            },
            "gridPos": {
                "h": 5,
                "w": 6,
                "x": 0,
                "y": 0
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "color": {
                        "mode": "thresholds"
                    }
                },
                "overrides": []
            },
            "options": {
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "center",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "orientation": "auto"
            },
            "targets": [
                {
                    "refId": "A",
                    "rawSql": "SELECT COUNT(*) AS value FROM lakehouse.rva.gold_track_summary WHERE visit_date = CURRENT_DATE"
                }
            ]
        },
        {
            "id": 2,
            "type": "stat",
            "title": "📈 Current Traffic (People Present Now)",
            "datasource": {
                "type": "trino-datasource",
                "uid": "trino-lakehouse"
            },
            "gridPos": {
                "h": 5,
                "w": 6,
                "x": 6,
                "y": 0
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "color": {
                        "mode": "thresholds"
                    }
                },
                "overrides": []
            },
            "options": {
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "center",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "orientation": "auto"
            },
            "targets": [
                {
                    "refId": "A",
                    "rawSql": "SELECT COUNT(DISTINCT track_id) AS value FROM lakehouse.rva.silver_detections WHERE capture_ts >= CURRENT_TIMESTAMP - INTERVAL '45' SECOND AND track_id IS NOT NULL"
                }
            ]
        },
        {
            "id": 3,
            "type": "stat",
            "title": "⏱️ Avg Visit Duration (Today)",
            "datasource": {
                "type": "trino-datasource",
                "uid": "trino-lakehouse"
            },
            "gridPos": {
                "h": 5,
                "w": 6,
                "x": 12,
                "y": 0
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "color": {
                        "mode": "thresholds"
                    }
                },
                "overrides": []
            },
            "options": {
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "center",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "orientation": "auto"
            },
            "targets": [
                {
                    "refId": "A",
                    "rawSql": "SELECT AVG(duration_sec) AS value FROM lakehouse.rva.gold_track_summary WHERE visit_date = CURRENT_DATE AND duration_sec > 0"
                }
            ]
        },
        {
            "id": 4,
            "type": "stat",
            "title": "🕐 Peak Hour (Enter Time)",
            "datasource": {
                "type": "trino-datasource",
                "uid": "trino-lakehouse"
            },
            "gridPos": {
                "h": 5,
                "w": 6,
                "x": 18,
                "y": 0
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "none",
                    "color": {
                        "mode": "thresholds"
                    },
                    "mappings": [
                        {
                            "type": "value",
                            "options": {
                                "0": {
                                    "text": "00h"
                                },
                                "1": {
                                    "text": "01h"
                                },
                                "2": {
                                    "text": "02h"
                                },
                                "3": {
                                    "text": "03h"
                                },
                                "4": {
                                    "text": "04h"
                                },
                                "5": {
                                    "text": "05h"
                                },
                                "6": {
                                    "text": "06h"
                                },
                                "7": {
                                    "text": "07h"
                                },
                                "8": {
                                    "text": "08h"
                                },
                                "9": {
                                    "text": "09h"
                                },
                                "10": {
                                    "text": "10h"
                                },
                                "11": {
                                    "text": "11h"
                                },
                                "12": {
                                    "text": "12h"
                                },
                                "13": {
                                    "text": "13h"
                                },
                                "14": {
                                    "text": "14h"
                                },
                                "15": {
                                    "text": "15h"
                                },
                                "16": {
                                    "text": "16h"
                                },
                                "17": {
                                    "text": "17h"
                                },
                                "18": {
                                    "text": "18h"
                                },
                                "19": {
                                    "text": "19h"
                                },
                                "20": {
                                    "text": "20h"
                                },
                                "21": {
                                    "text": "21h"
                                },
                                "22": {
                                    "text": "22h"
                                },
                                "23": {
                                    "text": "23h"
                                }
                            }
                        }
                    ]
                },
                "overrides": []
            },
            "options": {
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "center",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "orientation": "auto"
            },
            "targets": [
                {
                    "refId": "A",
                    "rawSql": "SELECT hour(enter_ts) AS value FROM lakehouse.rva.gold_track_summary WHERE visit_date = CURRENT_DATE GROUP BY hour(enter_ts) ORDER BY COUNT(*) DESC LIMIT 1"
                }
            ]
        },
        {
            "id": 5,
            "type": "timeseries",
            "title": "📊 Traffic by Hour (Today)",
            "datasource": {
                "type": "trino-datasource",
                "uid": "trino-lakehouse"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 5
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "fillOpacity": 50
                    }
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "single"
                }
            },
            "targets": [
                {
                    "refId": "A",
                    "rawSql": "SELECT date_trunc('hour', enter_ts) AS time, COUNT(*) AS value FROM lakehouse.rva.gold_track_summary WHERE visit_date = CURRENT_DATE GROUP BY 1 ORDER BY 1 ASC"
                }
            ]
        },
        {
            "id": 6,
            "type": "timeseries",
            "title": "📈 7-Day Trend (Visitors per Day)",
            "datasource": {
                "type": "trino-datasource",
                "uid": "trino-lakehouse"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 5
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "fillOpacity": 20
                    }
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "single"
                }
            },
            "targets": [
                {
                    "refId": "A",
                    "rawSql": "SELECT CAST(visit_date AS timestamp) AS time, COUNT(*) AS value FROM lakehouse.rva.gold_track_summary WHERE visit_date >= CURRENT_DATE - INTERVAL '7' DAY GROUP BY visit_date ORDER BY visit_date ASC"
                }
            ]
        },
        {
            "id": 7,
            "type": "timeseries",
            "title": "⏰ Real-time Traffic (Last 2 Hours)",
            "datasource": {
                "type": "trino-datasource",
                "uid": "trino-lakehouse"
            },
            "gridPos": {
                "h": 8,
                "w": 24,
                "x": 0,
                "y": 13
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "fillOpacity": 30
                    }
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "single"
                }
            },
            "targets": [
                {
                    "refId": "A",
                    "rawSql": "SELECT date_trunc('minute', capture_ts) AS time, COUNT(DISTINCT track_id) AS value FROM lakehouse.rva.silver_detections WHERE capture_ts >= CURRENT_TIMESTAMP - INTERVAL '2' HOUR GROUP BY 1 ORDER BY 1 ASC"
                }
            ]
        }
    ]
}