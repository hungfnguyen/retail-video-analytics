    "panels": [
        {
            "id": 1,
            "type": "stat",
            "title": "👁️ Live Now (Last 1 min)",
            "description": "People currently visible in camera",
            "datasource": {
                "type": "trino-datasource",
                "uid": "trino-lakehouse"
            },
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 0,
                "y": 0
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            { "color": "green", "value": null },
                            { "color": "yellow", "value": 5 },
                            { "color": "orange", "value": 10 },
                            { "color": "red", "value": 20 }
                        ]
                    }
                },
                "overrides": []
            },
            "options": {
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "orientation": "auto"
            },
            "targets": [
                {
                    "refId": "A",
                    "rawSql": "SELECT COUNT(DISTINCT track_id) AS value FROM lakehouse.rva.silver_detections WHERE capture_ts >= CURRENT_TIMESTAMP - INTERVAL '60' SECOND AND track_id IS NOT NULL"
