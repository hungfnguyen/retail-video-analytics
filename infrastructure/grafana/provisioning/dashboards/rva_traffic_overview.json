            "targets": [
                {
                    "refId": "A",
                    "rawSql": "SELECT date_trunc('minute', capture_ts) AS time, COUNT(DISTINCT track_id) AS value FROM lakehouse.rva.silver_detections WHERE capture_ts >= CURRENT_TIMESTAMP - INTERVAL '2' HOUR AND track_id IS NOT NULL GROUP BY 1 ORDER BY 1 ASC"
                }
            ]
