                "tooltip": {
                    "mode": "single"
                },
                "orientation": "vertical",
                "barWidth": 0.8,
                "xTickLabelRotation": 0
            },
            "targets": [
                {
                    "refId": "A",
                    "rawSql": "SELECT CONCAT(LPAD(CAST(hour(enter_ts) AS VARCHAR), 2, '0'), ':00') AS hour, COUNT(*) AS visitors FROM lakehouse.rva.gold_track_summary WHERE visit_date = CURRENT_DATE GROUP BY hour(enter_ts) ORDER BY hour(enter_ts) ASC"
                }
            ]
