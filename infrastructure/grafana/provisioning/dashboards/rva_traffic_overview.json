        {
            "id": 12,
            "type": "table",
            "title": "🔥 Khung Giờ Vàng (Visits per Hour × Day of Week)",
            "description": "Planning ca làm, bố trí nhân sự, khuyến mãi theo giờ/ngày. Data 7 ngày gần nhất.",
            "datasource": {
                "type": "trino-datasource",
                "uid": "trino-lakehouse"
            },
            "gridPos": {
                "h": 12,
                "w": 14,
                "x": 0,
                "y": 28
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "custom": {
                        "align": "center",
                        "displayMode": "color-background-solid",
                        "filterable": false
                    },
                    "thresholds": {
                        "mode": "percentage",
                        "steps": [
                            { "color": "transparent", "value": null },
                            { "color": "green", "value": 20 },
                            { "color": "yellow", "value": 50 },
                            { "color": "orange", "value": 70 },
                            { "color": "red", "value": 90 }
                        ]
                    }
                },
                "overrides": [
                    {
                        "matcher": { "id": "byName", "options": "hour" },
                        "properties": [
                            { "id": "custom.width", "value": 70 },
                            { "id": "custom.displayMode", "value": "auto" }
                        ]
                    }
                ]
            },
            "options": {
                "showHeader": true,
                "cellHeight": "sm",
                "footer": {
                    "show": false
                }
            },
            "transformations": [
                {
                    "id": "pivot",
                    "options": {
                        "columnField": "day_name",
                        "valueField": "visits",
                        "rowField": "hour"
                    }
                }
            ],
            "targets": [
                {
                    "refId": "A",
                    "rawSql": "SELECT CONCAT(LPAD(CAST(hour(enter_ts) AS VARCHAR), 2, '0'), ':00') AS hour, CASE day_of_week(visit_date) WHEN 1 THEN '1_Mon' WHEN 2 THEN '2_Tue' WHEN 3 THEN '3_Wed' WHEN 4 THEN '4_Thu' WHEN 5 THEN '5_Fri' WHEN 6 THEN '6_Sat' WHEN 7 THEN '7_Sun' END AS day_name, COUNT(*) AS visits FROM lakehouse.rva.gold_track_summary WHERE visit_date >= CURRENT_DATE - INTERVAL '7' DAY GROUP BY hour(enter_ts), day_of_week(visit_date) ORDER BY hour(enter_ts) ASC, day_of_week(visit_date) ASC"
                }
            ]
        },
        {
            "id": 13,
            "type": "barchart",
            "title": "⏱️ Visit Duration by Time of Day",
            "description": "Buổi nào khách ở lâu hơn? → Phù hợp cho chương trình trải nghiệm, khuyến mãi.",
            "datasource": {
                "type": "trino-datasource",
                "uid": "trino-lakehouse"
            },
            "gridPos": {
                "h": 12,
                "w": 10,
                "x": 14,
                "y": 28
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "color": {
                        "mode": "palette-classic"
                    }
                },
                "overrides": [
                    {
                        "matcher": { "id": "byName", "options": "avg_duration" },
                        "properties": [
                            { "id": "displayName", "value": "Avg Duration" },
                            { "id": "color", "value": { "fixedColor": "#73BF69", "mode": "fixed" } }
                        ]
                    },
                    {
                        "matcher": { "id": "byName", "options": "max_duration" },
                        "properties": [
                            { "id": "displayName", "value": "Max Duration" },
                            { "id": "color", "value": { "fixedColor": "#F2495C", "mode": "fixed" } }
                        ]
                    },
                    {
                        "matcher": { "id": "byName", "options": "visitors" },
                        "properties": [
                            { "id": "displayName", "value": "Visitors" },
                            { "id": "unit", "value": "short" },
                            { "id": "color", "value": { "fixedColor": "#5794F2", "mode": "fixed" } }
                        ]
                    }
                ]
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "multi"
                },
                "orientation": "horizontal",
                "barWidth": 0.7,
                "groupWidth": 0.8,
                "stacking": "none",
                "showValue": "auto"
            },
            "targets": [
                {
                    "refId": "A",
                    "rawSql": "SELECT CASE WHEN hour(enter_ts) BETWEEN 6 AND 11 THEN '🌅 Morning (06-11h)' WHEN hour(enter_ts) BETWEEN 12 AND 14 THEN '☀️ Lunch (12-14h)' WHEN hour(enter_ts) BETWEEN 15 AND 17 THEN '🌤️ Afternoon (15-17h)' WHEN hour(enter_ts) BETWEEN 18 AND 21 THEN '🌙 Evening (18-21h)' ELSE '🌃 Night (22-05h)' END AS time_period, CAST(AVG(duration_sec) AS INTEGER) AS avg_duration, MAX(duration_sec) AS max_duration, COUNT(*) AS visitors FROM lakehouse.rva.gold_track_summary WHERE duration_sec >= 5 AND visit_date >= CURRENT_DATE - INTERVAL '7' DAY GROUP BY CASE WHEN hour(enter_ts) BETWEEN 6 AND 11 THEN '🌅 Morning (06-11h)' WHEN hour(enter_ts) BETWEEN 12 AND 14 THEN '☀️ Lunch (12-14h)' WHEN hour(enter_ts) BETWEEN 15 AND 17 THEN '🌤️ Afternoon (15-17h)' WHEN hour(enter_ts) BETWEEN 18 AND 21 THEN '🌙 Evening (18-21h)' ELSE '🌃 Night (22-05h)' END ORDER BY 1"
                }
            ]
        },
