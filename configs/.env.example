# ========================================
# Retail Video Analytics - Environment Variables Template
# ========================================
# Copy this file to .env and fill in your actual values
# cp configs/.env.example .env

# === MinIO (S3-compatible Object Storage) ===
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
MINIO_SERVER_URL=http://minio:9000

# === Iceberg REST Catalog ===
ICEBERG_CATALOG_URI=http://iceberg-rest:8181
ICEBERG_WAREHOUSE=s3a://warehouse

# === S3/MinIO Configuration for Iceberg FileIO ===
S3_ENDPOINT=http://minio:9000
S3_PATH_STYLE=true
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=CHANGE_ME_TO_STRONG_PASSWORD

# === Grafana ===
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# === Airflow (Optional - not currently active) ===
# Generate Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=GENERATE_YOUR_OWN_FERNET_KEY
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
# Linux: 1000, Windows/Mac: 50000
AIRFLOW_UID=1000
