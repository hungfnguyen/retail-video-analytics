# Multi-camera configuration
# 2 cameras: video1.mp4 (main entrance), video2.mp4 (aisle)

cameras:
  - camera_id: cam_01
    store_id: store_001
    name: "Cam_1"
    source_type: video_file
    source_uri: data/videos/video1.mp4
    enabled: true
    fps_target: 25

  - camera_id: cam_02
    store_id: store_001
    name: "Cam_2"
    source_type: video_file
    source_uri: data/videos/Video_1.mp4
    enabled: true
    fps_target: 25

settings:
  model_name: yolo11l.pt
  tracker_type: botsort
  conf_thres: 0.25
  class_filter: [0]
  frame_queue_size: 1

  # Short-term track memory bridges brief retail occlusions so live count and
  # overlays do not flicker when a shopper is hidden for a few frames.
  track_memory_enabled: true
  track_lost_ttl_ms: 1000
  track_lost_ttl_frames: 15
  track_min_hits: 1
  track_smooth_alpha: 0.65
  track_publish_predicted: true
  track_count_predicted: true
  track_predicted_conf_decay: 0.85
  track_min_predicted_conf: 0.20
  track_reid_iou_threshold: 0.15
  track_reid_center_distance_px: 120

  health_check_interval_sec: 10
  worker_graceful_shutdown_sec: 10
  reconnect_delay_max_sec: 30

  # Live media plane for dashboard video. Vision writes annotated latest JPEGs
  # here; FastAPI serves them as MJPEG through /media/live/{camera_id}/stream.
  live_media_enabled: true
  live_media_dir: runtime/live_frames
  live_media_fps: 15
  live_media_jpeg_quality: 75

  # Media plane: sampled JPEGs and optional alert clips to S3.
  # S3 infrastructure values are loaded from .env: S3_ENDPOINT, S3_REGION,
  # S3_BUCKET, S3_ACCESS_KEY, S3_SECRET_KEY, S3_PATH_STYLE.
  media_upload_enabled: true
  pulsar_media_topic: persistent://retail/metadata/media-events

  frame_sampling_enabled: true
  frame_sample_interval_sec: 1
  frame_jpeg_quality: 85
  frame_upload_workers: 2
  frame_upload_inflight_limit: 8

  # Clip extraction is implemented but disabled by default because it encodes
  # every frame into a small pre-buffer. Enable it when testing alert replay.
  # Density alerts are emitted when current people count exceeds this threshold.
  alert_clip_enabled: false
  alert_density_threshold: 10
  alert_pre_buffer_sec: 5
  alert_post_buffer_sec: 5
  alert_cooldown_sec: 30
  clip_jpeg_quality: 80
  clip_upload_workers: 1
