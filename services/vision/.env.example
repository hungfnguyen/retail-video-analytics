# ========================================
# Vision AI Module - Environment Variables Template
# ========================================
# Copy this file to services/vision/.env for single-camera fallback mode.
# Normal multi-camera production reads configs/cameras.yaml. Use RVA_* env vars
# for explicit production overrides without accidentally overriding YAML.

# === Detector Configuration ===
# Model file must exist in services/vision/detect/models/
MODEL_NAME=yolo11l.pt
RVA_MODEL_NAME=yolo11l.pt
FORCE_GPU=1

# === Video Input ===
# Path to video file relative to services/vision, absolute path, or camera device ID.
VIDEO_PATH=video/video_test.mp4

# === Supervision / Roboflow Trackers ===
# The rebuilt pipeline runs YOLO predict -> sv.Detections -> Roboflow Trackers.
# The previous tracker-specific prototype stack is not used.
TRACKER_TYPE=roboflow_bytetrack
RVA_TRACKER_TYPE=roboflow_bytetrack

# === Detection Settings ===
# COCO class [0] = person. Keep confidence low enough for ByteTrack association.
CLASS_FILTER=[0]
RVA_CLASS_FILTER=[0]
CONF_THRES=0.15
RVA_CONF_THRES=0.15

# === Output Configuration ===
OUT_JSONL=../../data/metadata/video.jsonl

# === Store/Camera Metadata ===
STORE_ID=store_01
CAMERA_ID=cam_01
STREAM_ID=stream_01

# === Pulsar Streaming Configuration ===
# Use localhost:6650 from host, pulsar-broker:6650 from Docker.
PULSAR_SERVICE_URL=pulsar://localhost:6650
PULSAR_TOPIC=persistent://retail/metadata/events
PULSAR_MEDIA_TOPIC=persistent://retail/metadata/media-events

# === S3/MinIO Media Upload ===
# In normal multi-camera mode, configs/cameras.yaml plus root .env provide these.
MEDIA_UPLOAD_ENABLED=true
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=warehouse
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_PATH_STYLE=true

FRAME_SAMPLING_ENABLED=false
FRAME_SAMPLE_INTERVAL_SEC=1
FRAME_JPEG_QUALITY=85
FRAME_UPLOAD_WORKERS=2
FRAME_UPLOAD_INFLIGHT_LIMIT=8

ALERT_CLIP_ENABLED=false
ALERT_DENSITY_THRESHOLD=10
ALERT_PRE_BUFFER_SEC=5
ALERT_POST_BUFFER_SEC=5
ALERT_COOLDOWN_SEC=30
CLIP_JPEG_QUALITY=80
CLIP_UPLOAD_WORKERS=1
